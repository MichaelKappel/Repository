@using ExampleImplementation.Website.Models.DataModels
@using ExampleImplementation.Website.Models.ViewModels

@model PaggingGridControlViewModel

@{
    var columns = typeof(ExampleDataViewModel).GetProperties();
}

<div class="mb-2 text-muted small">
    Showing @Model.PageRecordCount of @Model.TotalRecordCount total products.
</div>

<table class="border table table-sm table-striped">
    <thead>
        <tr>
            <td colspan="10">
                @await Html.PartialAsync("_PaggingControl", Model)
            </td>
        </tr>
        <tr>
            @foreach (var property in columns)
            {
                <th>@property.Name</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Results)
        {
            <tr>
                @foreach (var property in columns)
                {
                    <td>@property.GetValue(row)</td>
                }
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="10">
                @await Html.PartialAsync("_PaggingControl", Model)
            </td>
        </tr>
    </tfoot>
</table>
